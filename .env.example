# Copy this file to .env and fill it in. .env is git-ignored.

# Address of the app you are documenting (a test/staging environment is best).
BASE_URL=https://your-app.example.com

# Set to 1 if your internal site uses a self-signed or company-issued certificate
# that the browser doesn't trust.
# IGNORE_HTTPS_ERRORS=1

# Set to 1 to watch the browser while capturing (handy when a flow fails).
# HEADED=1

# Path to an ffmpeg binary, if the bundled one couldn't be downloaded on your network.
# FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe

# How long each click or fill may wait for its element before failing, in ms (default 15000).
# ACTION_TIMEOUT=15000
